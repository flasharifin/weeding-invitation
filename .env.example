# ===== Database (Neon Postgres) =====
# Neon Console -> project -> Connect -> salin connection string.
# Untuk Vercel (serverless) pakai versi "pooled" (host mengandung -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ===== Login =====
ADMIN_PASSWORD=ganti-ini
STAFF_PASSWORD=ganti-ini-juga

# String acak panjang, mis: openssl rand -base64 32
SESSION_SECRET=

# ===== Sumopod / S3-compatible object storage =====
# Sumopod -> Object Storage -> Manage -> Quick Start / Credentials.
# Endpoint = root S3 API endpoint, not a bucket/file URL. Keep the bucket private.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true = URL bentuk endpoint/bucket/file (path-style); false = bucket.endpoint (subdomain).
# Default false. Sumopod/MinIO dan banyak provider S3-compatible BUTUH "true" —
# kalau upload gagal, ini penyebab paling umum, coba ganti ke true.
S3_FORCE_PATH_STYLE=false

# Uji konfigurasi sebelum dipakai:
#   npm run storage:check    -> cek bucket bisa diakses (hanya baca)
#   npm run storage:verify   -> uji unggah + baca + hapus sungguhan (sangat disarankan)
# Jika gagal, pesan error dari server penyimpanan akan ditampilkan apa adanya.
